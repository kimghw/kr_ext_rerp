{
  "manifest_version": 3,
  "name": "KR eClass + R&D ERP 현황",
  "version": "0.6.8",
  "description": "eClass 홈 화면에 R&D ERP(rnd.krs.co.kr)의 미승인내역, 과제별 카드미청구 내역, 과제집행비율(비목별 예산잔액, 예상 비용 계획), 과제 참여율(예비 참여율·기간 계획)과 HR System(hr.krs.co.kr) 급여명세서의 기본연봉·올해 연구수당(직급별 한도·잔여)을 표시하고, ERP 청구서(카드) 화면의 입력(예산·RCMS 기본값, 세목 빠른 선택, 첨부 드래그 앤 드롭)을 돕습니다.",
  "permissions": ["storage", "alarms", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://rnd.krs.co.kr/*", "https://eclass.krs.co.kr/*", "https://hr.krs.co.kr/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "R&D ERP 현황",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://eclass.krs.co.kr/eClassVer4/Home/Index*",
        "https://eclass.krs.co.kr/eClassVer4/Home",
        "https://eclass.krs.co.kr/eClassVer4/Home/",
        "https://eclass.krs.co.kr/eClassVer4/",
        "https://eclass.krs.co.kr/eClassVer4"
      ],
      "js": ["lib/format.js", "lib/settings.js", "lib/plan.js", "lib/pay.js", "lib/part.js", "lib/render.js", "content/eclass.js"],
      "css": ["lib/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rnd.krs.co.kr/*"],
      "js": ["content/rnd-hook.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://rnd.krs.co.kr/*"],
      "js": ["lib/settings.js", "content/rnd-bridge.js", "content/rnd-claim.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://hr.krs.co.kr/*"],
      "js": ["lib/format.js", "lib/settings.js", "lib/hr-api.js", "content/hr-pay.js"],
      "run_at": "document_idle"
    }
  ]
}
